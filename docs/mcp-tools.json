    {
      "name": "updateEnergySettings",
      "description": "Set daily maintenance excluding separately logged exercise, or null to clear it. Not BMR, intake target, or exercise-inclusive TDEE. This recalculates historical balances with the new baseline. Never infer this from intake goals. Execute ONLY after the user explicitly confirms this exact change in ChatGPT. Save immediately without dashboard approval. Reuse request_id and identical values on retries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
