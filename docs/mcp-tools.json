          },
          "maintenance_calories": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 500,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ],
            "description": "Estimated daily maintenance kcal including normal activity but EXCLUDING separately logged workouts. Not BMR, intake target, or exercise-inclusive TDEE. Null clears the estimate. Changing this recalculates all historical balances."
          }
        },
        "required": [
          "request_id",
          "maintenance_calories"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
