{
  "rewrites": [
    {
      "source": "/mcp/status",
      "destination": "/api/mcp?status=1"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/mcp?metadata=1"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?metadata=1"
    },
    {
      "source": "/oauth/consent",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/oauth/consent",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 30
    }
  }
}
